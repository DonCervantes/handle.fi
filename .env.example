# Copy this to apps/api/.env and fill in your values

# Database (Neon.tech free tier recommended)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# OpenAI
OPENAI_API_KEY=sk-...

# Privy (https://privy.io)
PRIVY_APP_ID=clv...
PRIVY_APP_SECRET=...

# Arbitrum Sepolia (Alchemy)
ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY
DEPLOYER_PRIVATE_KEY=0x...

# Smart Contract Addresses (filled after deploy)
CREDENTIAL_REGISTRY_ADDRESS=0x...
AUDIT_REGISTRY_ADDRESS=0x...

# Web (copy relevant vars to apps/web/.env.local with NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_PRIVY_APP_ID=clv...
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_AUDIT_REGISTRY_ADDRESS=0x...
